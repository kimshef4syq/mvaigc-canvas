              <div class="th" style="height:96px;background:${thumb(ti)}"><div class="no">SHOT ${no}</div><div class="du">${du}</div></div>
              <div class="meta" style="height:46px"><b>镜头 ${no}</b><br>${line}</div></div>`).join('')}
          </div>
        </div>
      </div>
      <div style="width:500px;flex:none;display:flex;flex-direction:column;gap:12px">
        <div class="card"><div class="ch">批注 · 2<span class="sp"></span><span class="tag">实时</span></div>
          <div style="padding:14px;display:flex;flex-direction:column;gap:12px">
            <div class="cmt" data-a="cmt1"><div class="pin"></div><div class="who"><span class="av" style="width:22px;height:22px;font-size:11px;background:#9747FF">王</span>王导 · 2 分钟前</div>第 04 个镜头的转场再慢 0.4 秒，让光落下来。</div>
            <div class="cmt"><div class="pin"></div><div class="who"><span class="av" style="width:22px;height:22px;font-size:11px;background:#3DDCFF">李</span>李剪辑 · 刚刚</div>配音已对齐，第 09 句重录了一版，听一下。</div>
          </div>
        </div>
        <div class="card grow"><div class="ch">版本</div>
          <div style="padding:14px;display:flex;flex-direction:column;gap:10px">
            <div class="trk on"><span class="nm">v2 · 当前</span><span class="sp"></span><span class="tag acc">正在编辑</span></div>
            <div class="trk"><span class="nm">v1 · 3 小时前</span><span class="sp"></span><span class="tag">王导</span></div>
            <div class="trk"><span class="nm">v3 · 待合并</span><span class="sp"></span><span class="tag">李剪辑</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>`;
}

/* ---------- 07 成片预览 ---------- */
export function previewPage(o = {}) {
  const clips = [0, 1, 2, 3, 4, 5, 6, 7];
  const ph = o.ph ?? 0.68;
  const CITY = [[0, 150, 120], [130, 90, 150], [230, 60, 190], [300, 120, 130], [430, 80, 165], [520, 55, 210], [585, 130, 140], [730, 70, 180], [810, 110, 155], [930, 60, 200], [1000, 130, 135], [1140, 75, 170], [1220, 120, 145], [1350, 65, 185], [1430, 140, 120]];
  const CCOL = ['#141828', '#1B2138', '#0F1322', '#181C30', '#12162A'];
  return `<div class="pv">
    <div class="pvframe">
      <div class="film">
        <div class="sky"></div><div class="sun"></div>
        <div class="city">${CITY.map(([l, w, h], idx) => `<i style="left:${l}px;width:${w}px;height:${h}px;background:${CCOL[idx % CCOL.length]}"></i>`).join('')}</div>
        <div class="fog"></div><div class="vign"></div>
      </div>
      <div class="ttl">城市之光 · 成片预览</div>
      <div class="play">▶</div>
      <div class="dur">02:30 · 1080p</div>
    </div>
    <div class="tl">
      <div class="ruler"><span>00:00</span><span>00:30</span><span>01:00</span><span>01:30</span><span>02:00</span><span>02:30</span></div>
      <div class="row">
        ${clips.map(i => `<div class="clip" style="background:${thumb(i)}"><span class="lab">SHOT 0${i + 1}</span></div>`).join('')}
        <div class="phd" style="left:${ph * 100}%"></div>
      </div>
      <div class="tl2">${clips.map(() => '<div class="a"></div>').join('')}</div>
    </div>
  </div>`;
}

