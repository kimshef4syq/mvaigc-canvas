/* ---------- 01 主页（落地页） ---------- */
const QUICK = [['✦', '海报制作', '一键生成精美海报'], ['▣', '视频生成', 'AI 智能生成视频'], ['◫', '宣传片', '专业级宣传片制作'],
['☺', '数字人主播', '数字人智能播报'], ['♪', 'AI 音频制作', 'AI 生成原创音乐'], ['⌘', '工作流', '自定义创作流程'],
['⌫', '视频擦除', '智能去除视频元素'], ['⤢', '视频超分', '提升视频清晰度']];
const WORKS = [['视频', '三根杆子', '高品质短剧', 0], ['视频', '起征·晨光', '高品质短剧', 4], ['视频', '动物园宣传', '动物园宣传', 2],
['视频', '哈尔滨啤酒', '哈尔滨啤酒', 3], ['视频', '短剧', '高品质短剧', 5]];

export function homePage(o = {}) {
  const panels = (flip) => Array.from({ length: 6 }, (_, i) => {
    const col = i % 2, row = (i / 2) | 0;
    const x = col * 150 + (flip ? 0 : 0), y = row * 168;
    return `<div class="pane" style="left:${flip ? 'auto' : x + 'px'};right:${flip ? x + 'px' : 'auto'};top:${y}px;
      transform:rotateY(${flip ? -26 : 26}deg) translateZ(${-col * 26}px)"><div class="in" style="background:${thumb(i + (flip ? 3 : 0))}"><i></i></div></div>`;
  }).join('');
  const streaks = Array.from({ length: 9 }, (_, i) => {
    const y = 240 + i * 46, w = 420 + (i % 3) * 180, rot = -14 + (i % 5) * 7;
    return `<i style="left:${18 + (i % 4) * 20}%;top:${y}px;width:${w}px;transform:rotate(${rot}deg);opacity:${.28 + (i % 3) * .12}"></i>`;
  }).join('');
  return `<div class="homewrap"><div class="home">
    <div class="glow g1"></div><div class="glow g2"></div>
    <div class="streaks">${streaks}</div>
    <div class="tags"><span>AI 驱动创意</span><span>数据赋能决策</span><span>内容连接价值</span></div>
    <div class="wall">${panels(false)}${panels(true)}</div>
    <div class="mark"><img src="assets/logo.svg" alt=""><div class="nm">融媒视界</div><div class="en">MEDIA VISION</div></div>
    <div class="orb">AI</div>
    <div class="cta" data-a="start">✦ 开始创作</div>
    <div class="slogan">让创意被看见　让价值被连接</div>
    <div class="quick">${QUICK.map(([ic, nm, sub]) => `<div class="q"><div class="ic">${ic}</div><div class="nm">${nm}</div><div class="sub">${sub}</div></div>`).join('')}</div>
    <div class="works">${WORKS.map(([t, nm, sub, ti]) => `<div class="w" style="background:${thumb(ti)}"><span class="lab">${t}</span></div>`).join('')}</div>
  </div></div>`;
}

/* ---------- 02 AI 创作 ---------- */
const MODES = ['视频生成', '图片生成', '音乐创作', '配音工作台', '视频处理', '漫画生成'];
export function aiCreatePage(o = {}) {
  return `<div class="ai2">
    <div class="modes">${MODES.map((m, i) => `<div class="mode ${i === (o.mode ?? 0) ? 'on' : ''}">${m}</div>`).join('')}</div>
    <div class="prompt">
      <div class="ptxt">${o.text || '描述你想做的片子：<b>城市清晨</b>，镜头从楼群推近到天桥上的人，暖调，24 fps'}<span class="caret"></span></div>
      <div class="row"><div class="tag">16:9</div><div class="tag">1080p</div><div class="tag">24 fps</div><div class="tag acc">Seedance 2.0</div><div style="flex:1"></div><div class="gen" data-a="gen">生成</div></div>
    </div>
    <div class="recent">${[0, 1, 2, 3].map(i => `<div class="rc"><div class="th" style="background:${thumb(i)}"></div><div class="mt">${['海报 · 小暑', '短剧 · 城市清晨', '宣传片 · 品牌', '音乐 · 城市清晨'][i]}</div></div>`).join('')}</div>
    ${o.pet ? pet() : ''}
    ${o.drawer ? chatDrawer({ stage: o.drawer }) : ''}
  </div>`;
}

/* ---------- 03 无限画布列表 ---------- */
export function canvasListPage(o = {}) {
  const items = [['城市之光 · 宣传片', '8 个节点', 0], ['非遗新生 · 短剧', '12 个节点', 1], ['节气海报 · 小暑', '5 个节点', 2], ['品牌广告 · 30s', '9 个节点', 3], ['文旅长沙 · 海报', '6 个节点', 4]];
  return `<div class="cvlist">
    <div class="grid" style="grid-template-columns:repeat(3,1fr)">${items.map(([nm, n, ti], i) => `<div class="cc" ${o.hot === i ? 'style="border-color:var(--acc);box-shadow:0 0 0 2px rgba(151,71,255,.35)"' : ''}>
      <div class="th" style="background:${thumb(ti)};opacity:.92"><div class="mini">${Array.from({ length: 6 }, () => '<i></i>').join('')}</div></div>
      <div class="mt"><span>${nm}</span><span class="t">${n}</span></div></div>`).join('')}</div>
  </div>`;
}

/* ---------- 04 画布 v2 ---------- */
export function canvas2Page(o = {}) {
  const st = o.stage || 'empty';
  const nodes = [];
  if (st !== 'empty') nodes.push(`<div class="node on" style="left:300px;top:110px;width:250px" data-a="n0"><div class="nh"><span class="dot" style="background:#CFAAFF"></span>提示词节点</div><div class="nc">城市清晨，镜头从楼群推近到天桥上的人，暖调</div></div>`);
  if (st === 'imgbtn') nodes.push(`<div class="node" style="left:300px;top:300px;width:250px" data-a="nbtn"><div class="nh"><span class="dot" style="background:#3DDCFF"></span>生图节点</div><div class="btn" data-a="startimg">开始生成图片</div></div>`);
  if (st === 'images' || st === 'wired' || st === 'video' || st === 'videoGen') {
    nodes.push(`<div class="node" style="left:300px;top:300px;width:250px" data-a="nbtn"><div class="nh"><span class="dot" style="background:#3DDCFF"></span>生图节点</div><div class="nc">4 张 · 16:9 · 已生成</div></div>`);
    [0, 1, 2, 3].forEach(i => nodes.push(`<div class="node ${i === 0 ? 'on' : ''}" style="left:${620 + (i % 2) * 210}px;top:${150 + ((i / 2) | 0) * 190}px;width:190px" data-a="img${i}"><div class="nh"><span class="dot" style="background:#CFAAFF"></span>图片 ${i + 1}</div><div class="thumb" style="height:112px;background:${thumb(i)}"></div></div>`));
  }
  if (st === 'video' || st === 'videoGen') {
    nodes.push(`<div class="node ${st === 'video' ? 'on' : ''}" style="left:1080px;top:330px;width:300px" data-a="nv"><div class="nh"><span class="dot" style="background:#3BE08A"></span>视频节点</div><div class="promptbox">${st === 'videoGen' ? '生成中…<span class="caret"></span>' : '城市清晨，镜头推近，5s'}</div>${st === 'video' ? `<div class="thumb" style="height:150px;background:${thumb(0)}"></div>` : ''}</div>`);
  }
  const wire = (x1, y1, x2, y2) => `<path d="M${x1} ${y1} C${x1 + 60} ${y1}, ${x2 - 60} ${y2}, ${x2} ${y2}" stroke="#6A5A92" stroke-width="2" fill="none"/>`;
  const wires = st === 'wired' || st === 'video' || st === 'videoGen' ? `<svg class="wires">${wire(550, 340, 620, 250)}${wire(550, 340, 620, 440)}${wire(550, 340, 830, 250)}${wire(550, 340, 830, 440)}${wire(1010, 250, 1080, 400)}</svg>` : '';
  return `<div class="cv2" data-a="cv">${wires}${nodes.join('')}
    <div class="cvbar"><div class="tag">组镜模式</div><div class="tag">自动连线</div><div class="tag acc">已保存</div></div>
    <div class="cvzoom">100%</div>
  </div>`;
}

/* ---------- 05 视频特写 ---------- */
export function videoView(o = {}) {
  const CITY = [[0, 150, 120], [130, 90, 150], [230, 60, 190], [300, 120, 130], [430, 80, 165], [520, 55, 210], [585, 130, 140], [730, 70, 180], [810, 110, 155], [930, 60, 200], [1000, 130, 135], [1140, 75, 170], [1220, 120, 145], [1350, 65, 185], [1430, 140, 120]];
  const CCOL = ['#141828', '#1B2138', '#0F1322', '#181C30', '#12162A'];
  return `<div class="vzoom">
    <div class="film"><div class="sky"></div><div class="sun"></div>
      <div class="city">${CITY.map(([l, w, h], idx) => `<i style="left:${l}px;width:${w}px;height:${h}px;background:${CCOL[idx % CCOL.length]}"></i>`).join('')}</div>
      <div class="fog"></div><div class="vign"></div></div>
    <div class="badge">✦ 视频节点 · 5s · 1080p</div>
    <div class="bar"><div class="pl">▶</div><div class="tl"><i style="width:${o.p ?? 60}%"></i></div><div class="tm">${o.t || '00:03'} / 00:05</div></div>
  </div>`;
}

/* ---------- 智能体小宠物 + 对话框 ---------- */
export function pet(o = {}) {
  return `<div class="pet" data-a="pet"><div class="halo"></div><div class="bd"><span class="eye l"></span><span class="eye r"></span><span class="mo"></span></div></div>`;
}

const SKILLS = [
  ['◈', '剧本解析', '把剧本文本拆成场景与分镜'],
  ['▦', '分镜生成', '一个剧本，自动拆出 40 个镜头'],
  ['♪', '配音合成', '多音色中文配音，自动对齐字幕'],
  ['♬', '音乐创作', '按片子的情绪生成配乐'],
  ['◫', '海报生成', '从成片里出一张海报'],
];
export function chatDrawer(o = {}) {
  const st = o.stage || 'open';
  const skillList = st === 'open' ? '' : `<div class="skills">${SKILLS.map(([ic, nm, ds], i) => {
    const installing = st === 'installing' && i === 1;
    const done = (st === 'done') && i === 1;
    return `<div class="sk"><div class="ic">${ic}</div><div><div class="nm">${nm}</div><div class="ds">${ds}</div></div><div class="sp"></div>
      <div class="btn2 ${done ? 'done' : installing ? 'on' : ''}">${done ? '✓ 已安装' : installing ? '安装中…' : '安装'}</div></div>`;
  }).join('')}</div>`;
  return `<div class="drawer" data-a="drawer">
    <div class="dh"><div class="ava"></div><div><div class="nm">Mambo · 智能助手</div><div class="sub">官方技能 12 个 · 已装 3 个</div></div><div class="x">✕</div></div>
    <div class="msgs">
      <div class="bub"><div class="who">Mambo</div>你好，我是 Mambo。要不要装一个技能？装好之后我就能直接帮你拆剧本、出分镜。</div>
      ${st === 'open' ? '' : `<div class="bub me"><div class="who">你</div>装一个分镜技能。</div>`}
      ${st === 'open' ? '' : `<div class="bub"><div class="who">Mambo</div>官方技能里这几个最常用，点「安装」就能用：</div>`}
      ${skillList}
      ${st === 'done' ? `<div class="bub"><div class="who">Mambo</div>装好了。「分镜生成」已经在你左侧的技能栏里，随时可以用。</div>` : ''}
    </div>
    <div class="input"><div class="box">和 Mambo 说点什么…</div><div class="snd">↑</div></div>
  </div>`;
}
