{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mvaigc-canvas",
  "version": "0.2.1",
  "identifier": "com.ganbo-gab.open-storyboard-canvas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "mvaigc-canvas",
        "dragDropEnabled": false,
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/agent-profiles/": "resources/agent-profiles/",
      "../resources/hypit-provider-mvaigc/dist/": "resources/hypit-provider-mvaigc/dist/",
      "../resources/hypit-provider-mvaigc/package.json": "resources/hypit-provider-mvaigc/package.json",
      "../resources/hypit-provider-mvaigc/prepare-project.mjs": "resources/hypit-provider-mvaigc/prepare-project.mjs",
      "../public/supersplat/": "supersplat/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
